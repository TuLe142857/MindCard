# ---------------------------------
# Application Environment Profile
# Available options: dev | prod
# ---------------------------------
SPRING_PROFILES_ACTIVE=prod
CLOUD_FLARED_TUNNEL_TOKEN=

# ---------------------------------
# External Port Configuration
# Change these values if you experience port conflicts on your host machine
# ---------------------------------
BACKEND_PORT_EXTERNAL=8080
FRONTEND_PORT_EXTERNAL=5173
DB_PORT_EXTERNAL=5432
MINIO_API_PORT_EXTERNAL=9000
MINIO_CONSOLE_PORT_EXTERNAL=9001

# ---------------------------------
# Database Configuration (PostgreSQL)
# ---------------------------------
DB_HOST=db
DB_PORT=5432
DB_USER=
DB_PASSWORD=
DB_NAME=mindcard

# ---------------------------------
# MinIO (S3 Compatible Storage) Configuration
# ---------------------------------
MINIO_ROOT_USER=admin
MINIO_ROOT_PASSWORD=changethis

# ---------------------------------
# Application S3 Storage Configuration
# Uses MinIO as the S3 provider by default
# ---------------------------------
S3_ENDPOINT=http://s3:9000

# Use only when self-host s3
# docker enpoint use docker service name
# URL_OVERRIDE use public domain name
# S3_PUBLIC_URL_OVERRIDE=http://localhost:${MINIO_API_PORT_EXTERNAL}

S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=mindcard

# ---------------------------------
# Redis Configuration
# ---------------------------------
REDIS_HOST=redis
REDIS_PORT=6379

# ---------------------------------
# JWT (JSON Web Token) Configuration
# Replace the secret key with a strong, random string in production
# ---------------------------------
JWT_SECRET_KEY=
JWT_ACCESS_TOKEN_COOKIE_NAME=access_token
JWT_REFRESH_TOKEN_COOKIE_NAME=refresh_token
JWT_ACCESS_TOKEN_EXPIRATION_SECOND=1800
JWT_REFRESH_TOKEN_EXPIRATION_SECOND=604800

# ---------------------------------
# Mail Server Configuration
# For most popular & easy, use google mail server
# ---------------------------------
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_SEND_FROM=
MAIL_PASSWORD=